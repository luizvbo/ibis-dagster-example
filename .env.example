# Deployment selector: picks the resource set in definitions.py
# (local | polars | prod). Dagster+ sets it automatically; on self-hosted
# OSS set it in the code location's env; `dagster dev` defaults to local.
DAGSTER_DEPLOYMENT_NAME=local

# used by prod deployment source paths
# DATA_LAKE=data/lake                 # local lake; `just seed-lake` writes it from the CSVs
# DATA_LAKE=s3a://my-bucket/lake

# duckdb backend (local deployment)
IBIS_DUCKDB_PATH=warehouse.duckdb   # or ":memory:"

# pyspark backend (prod deployment; needs the pyspark extra + a JDK)
SPARK_MASTER=local[*]
SPARK_WAREHOUSE_DIR=./spark-warehouse
